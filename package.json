{
  "name": "allens-auto-refinement",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Website and staff portal for Allen's Auto Refinement (Virginia Beach, VA) — Netlify static + Functions + Postgres",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed-demo": "node scripts/seed-demo.mjs",
    "clear-demo": "node scripts/clear-demo.mjs",
    "create-user": "node scripts/create-user.mjs",
    "restore-backup": "node scripts/restore-backup.mjs",
    "dev": "netlify dev",
    "serve:local": "node scripts/local-server.mjs",
    "lint": "eslint .",
    "test": "node scripts/ensure-build.mjs && node --test --test-concurrency=1 test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@netlify/blobs": "~10.7.13",
    "@netlify/functions": "~5.3.0",
    "bcryptjs": "^3.0.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
