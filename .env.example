# Copy to .env for local CLI scripts. In production set these in Netlify:
# Site configuration → Environment variables (mark secrets as "Secret"). Never commit real values.

# ---- Required ----
# Postgres. With Netlify DB (Neon) this is provided automatically as NETLIFY_DATABASE_URL (pooled)
# and NETLIFY_DATABASE_URL_UNPOOLED; you don't need DATABASE_URL at all. For your own Neon
# project, paste the *pooled* connection string (host contains "-pooler").
DATABASE_URL=
# 32+ random characters. Signs staff access tokens and form tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- Recommended ----
# Canonical public URL (no trailing slash). Defaults to Netlify's URL variable.
SITE_URL=https://www.example.com

# ---- Optional: email notifications for new leads (choose one provider, or leave all blank) ----
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=
EMAIL_BREAKER_THRESHOLD=3
EMAIL_BREAKER_COOLDOWN_MS=60000

# ---- Optional tuning ----
# Seconds the CDN may serve an inventory page before revalidating (purges happen instantly on edits)
INVENTORY_CDN_TTL=300
DB_TIMEOUT_MS=4000
LOG_LEVEL=info
# Run migrations during production builds (default true). Set false to migrate manually.
MIGRATE_ON_BUILD=true
# Seed demo vehicles on the first production build/migrate (remove later: npm run clear-demo)
SEED_DEMO=false
# Runtime feature-flag overrides (see config/features.json), e.g.:
# FEATURE_SHOW_INVENTORY=false

# ---- Local only ----
# DATABASE_URL=pglite:./.pglite           # in-process Postgres, no install needed
# DATABASE_URL=postgres://aar:aar@localhost:5432/aar   # docker compose up -d
# BLOBS_DRIVER=fs
# COOKIE_INSECURE=true                    # plain-http local testing only
